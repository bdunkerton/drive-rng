{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Drive RNG: start game server",
      "type": "shell",
      "command": "npm start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "drive-rng",
        "pattern": {
          "regexp": "^__never__$"
        },
        "background": {
          "beginsPattern": "Drive RNG",
          "endsPattern": "running at",
          "activeBegins": true
        }
      },
      "group": "build"
    },
    {
      "label": "Drive RNG: run tests",
      "type": "shell",
      "command": "npm test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Drive RNG: simulate an AI race",
      "type": "shell",
      "command": "npm run sim",
      "problemMatcher": []
    }
  ]
}
